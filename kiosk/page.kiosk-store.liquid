{% layout none %}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
<link rel="preconnect" href="https://cdn.shopify.com" crossorigin />
<title>FLY MIAMI · ONE WORLD. ONE GAME.</title>
<style>
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;margin:0;padding:0}
  html,body{height:100%;background:#07070d;color:#f4f4f8;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;overflow:hidden}
  .accent{color:#ff3da6}
  /* top bar */
  #bar{position:fixed;top:0;left:0;right:0;height:64px;display:flex;align-items:center;justify-content:space-between;padding:0 22px;background:#0a0a12cc;backdrop-filter:blur(8px);border-bottom:1px solid #ffffff14;z-index:20}
  #bar .b{font-weight:800;font-size:20px;letter-spacing:.5px}
  #bar .b small{display:block;font-weight:500;color:#9aa0b5;font-size:10px;letter-spacing:2px}
  #aboutBtn{background:#ff3da6;color:#07070d;border:none;border-radius:999px;padding:10px 18px;font-weight:700;font-size:14px;cursor:pointer}
  /* gallery */
  #gallery{position:absolute;top:64px;left:0;right:0;bottom:0;overflow-y:auto;padding:20px;display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:18px;align-content:start}
  .card{background:#13131f;border:1px solid #ffffff12;border-radius:20px;overflow:hidden;cursor:pointer;transition:transform .12s,border-color .12s}
  .card:active{transform:scale(.97)}
  .card .ph{height:300px;background:radial-gradient(circle at 50% 40%,#1c1c2b,#0d0d16);display:flex;align-items:center;justify-content:center}
  .card .ph img{max-width:100%;max-height:100%;object-fit:contain;display:block}
  .card .ph .duck{font-size:60px}
  .card .m{padding:14px 16px 16px}
  .card h3{font-size:17px;line-height:1.25}
  .card .p{margin-top:6px;color:#ffcf4d;font-weight:700;font-size:15px}
  .card .tap{margin-top:8px;font-size:11px;letter-spacing:1px;text-transform:uppercase;color:#7f8598}
  .empty{grid-column:1/-1;padding:60px;text-align:center;color:#9aa0b5;font-size:16px;line-height:1.6}
  /* overlay shared */
  .ov{position:fixed;inset:0;z-index:40;display:none}
  .ov.on{display:block}
  /* welcome / attract */
  #welcome{background:#07070d}
  #wbg{position:absolute;inset:0;overflow:hidden}
  #wbg img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity 1.6s ease;filter:brightness(.45) saturate(1.1);transform:scale(1.05)}
  #wbg img.show{opacity:1}
  #wcontent{position:relative;height:100%;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:40px;background:linear-gradient(180deg,#07070dcc,#07070d99,#07070dcc)}
  #wcontent h1{font-size:min(8vw,60px);font-weight:900;line-height:1;letter-spacing:-1px}
  #wcontent .sub{margin-top:10px;color:#cfd2e0;font-weight:600;font-size:min(3.6vw,18px);letter-spacing:1px}
  #wstory{margin-top:22px;max-width:760px;color:#dfe2ee;font-size:min(3.6vw,16px);line-height:1.6}
  #wstory b{color:#fff}
  .cta{margin-top:30px;font-size:14px;letter-spacing:3px;text-transform:uppercase;color:#ff3da6;animation:pulse 1.8s infinite}
  @keyframes pulse{0%,100%{opacity:.45}50%{opacity:1}}
  /* detail */
  #detail{background:#07070df2;backdrop-filter:blur(6px)}
  #dwrap{height:100%;display:flex;flex-direction:column}
  #dimgwrap{flex:1;min-height:0;display:flex;align-items:center;justify-content:center;padding:64px 24px 12px}
  #dimg{max-width:100%;max-height:100%;object-fit:contain;border-radius:14px}
  #dinfo{flex:0 0 auto;max-height:42vh;overflow-y:auto;padding:14px 26px 26px;border-top:1px solid #ffffff14;background:#0c0c16}
  #dinfo h2{font-size:24px;margin-bottom:6px}
  #dprice{color:#ffcf4d;font-weight:700;font-size:19px;margin-bottom:12px}
  #ddesc{color:#dfe2ee;font-size:15px;line-height:1.6;max-width:820px}
  #ddesc ul,#ddesc ol{margin:8px 0 0 20px}
  #ddesc li{margin:3px 0}
  #ddesc p{margin:0 0 8px}
  #ddesc b,#ddesc strong{color:#fff}
  .x{position:fixed;top:14px;right:18px;width:46px;height:46px;border-radius:999px;background:#ffffff1a;color:#fff;font-size:30px;line-height:46px;text-align:center;cursor:pointer;z-index:50}
  .nav{position:fixed;top:50%;transform:translateY(-50%);width:54px;height:54px;border-radius:999px;background:#ffffff1a;color:#fff;font-size:30px;line-height:54px;text-align:center;cursor:pointer;z-index:50}
  #prev{left:16px}#next{right:16px}
  .buy{display:inline-block;margin-top:6px;background:#ff3da6;color:#07070d;font-weight:700;text-decoration:none;border-radius:999px;padding:10px 20px;font-size:14px}
</style>
</head>
<body>

<div id="bar">
  <div class="b">ONE WORLD. ONE GAME. <small>FACUNDO YEBNE · FLY · KIMPTON EPIC</small></div>
  <button id="aboutBtn">About the show</button>
</div>

<section id="gallery"></section>

<!-- welcome / attract -->
<div class="ov" id="welcome">
  <div id="wbg"></div>
  <div id="wcontent">
    <h1>ONE WORLD<span class="accent">.</span> ONE GAME<span class="accent">.</span></h1>
    <div class="sub">by Facundo Yebne · FLY · Kimpton EPIC Hotel</div>
    <div id="wstory"></div>
    <div class="cta">Tap anywhere to explore</div>
  </div>
</div>

<!-- detail -->
<div class="ov" id="detail">
  <span class="x" id="dclose">&times;</span>
  <div class="nav" id="prev">&#8249;</div>
  <div class="nav" id="next">&#8250;</div>
  <div id="dwrap">
    <div id="dimgwrap"><img id="dimg" alt="" /></div>
    <div id="dinfo">
      <h2 id="dtitle"></h2>
      <div id="dprice"></div>
      <div id="ddesc"></div>
      <a class="buy" id="dbuy" href="#" target="_blank" rel="noopener">View online</a>
    </div>
  </div>
</div>

<script>
window.KIOSK = {
  about: {{ collections['kiosk'].description | default: 'Tap any piece to hear its story.' | json }},
  art: [
    {% for product in collections['kiosk'].products %}{
      t: {{ product.title | json }},
      p: {{ product.price | money_without_trailing_zeros | json }},
      img: {% if product.featured_image %}{{ product.featured_image | image_url: width: 1000 | json }}{% else %}""{% endif %},
      d: {{ product.description | json }},
      url: {{ product.url | json }}
    }{% unless forloop.last %},{% endunless %}{% endfor %}
  ]
};
</script>
<script>
(function(){
  var ART = (window.KIOSK && window.KIOSK.art) || [];
  var gallery = document.getElementById("gallery");
  var detail = document.getElementById("detail");
  var welcome = document.getElementById("welcome");
  var cur = 0, idleTimer = null;

  function esc(s){ return (s||"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }
  function escA(s){ return esc(s).replace(/"/g,"&quot;"); }

  /* ---- story ---- */
  document.getElementById("wstory").innerHTML = window.KIOSK.about || "";

  /* ---- gallery ---- */
  if(!ART.length){
    gallery.innerHTML = '<div class="empty">No pieces yet. In Shopify, add products to the <b>Kiosk</b> collection and they appear here.</div>';
  } else {
    ART.forEach(function(a,i){
      var c = document.createElement("div"); c.className="card";
      var vis = a.img ? '<img src="'+a.img+'" loading="lazy" decoding="async" alt="'+escA(a.t)+'">' : '<span class="duck">🦆</span>';
      c.innerHTML = '<div class="ph">'+vis+'</div><div class="m"><h3>'+esc(a.t)+'</h3><div class="p">'+esc(a.p)+'</div><div class="tap">Tap for the story</div></div>';
      c.onclick = function(){ openDetail(i); };
      gallery.appendChild(c);
    });
  }

  /* ---- detail ---- */
  function openDetail(i){
    cur = (i + ART.length) % ART.length;
    var a = ART[cur];
    document.getElementById("dimg").src = a.img || "";
    document.getElementById("dtitle").textContent = a.t;
    document.getElementById("dprice").textContent = a.p;
    document.getElementById("ddesc").innerHTML = a.d || "One of a kind original by Facundo Yebne.";
    var buy = document.getElementById("dbuy");
    if(a.url){ buy.href = a.url; buy.style.display="inline-block"; } else { buy.style.display="none"; }
    detail.classList.add("on");
  }
  document.getElementById("dclose").onclick = function(){ detail.classList.remove("on"); };
  document.getElementById("next").onclick = function(){ openDetail(cur+1); };
  document.getElementById("prev").onclick = function(){ openDetail(cur-1); };

  /* ---- welcome / attract ---- */
  var wbg = document.getElementById("wbg"), imgs = [], slideTimer = null, si = 0;
  ART.forEach(function(a){ if(a.img){ var im=document.createElement("img"); im.src=a.img; wbg.appendChild(im); imgs.push(im); } });
  function slide(){ if(!imgs.length) return; imgs.forEach(function(x){x.classList.remove("show");}); imgs[si % imgs.length].classList.add("show"); si++; }
  function showWelcome(){ welcome.classList.add("on"); detail.classList.remove("on"); si=0; slide(); slideTimer=setInterval(slide,5000); }
  function hideWelcome(){ welcome.classList.remove("on"); clearInterval(slideTimer); }
  welcome.onclick = hideWelcome;
  document.getElementById("aboutBtn").onclick = showWelcome;

  /* ---- idle reset: back to welcome after 90s ---- */
  function resetIdle(){ clearTimeout(idleTimer); idleTimer=setTimeout(showWelcome, 90000); }
  ["click","touchstart","keydown"].forEach(function(ev){ document.addEventListener(ev, resetIdle, true); });
  resetIdle();
  showWelcome();
})();
</script>
</body>
</html>
