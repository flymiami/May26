{% layout none %}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
<link rel="preconnect" href="https://cdn.shopify.com" crossorigin />
<title>FLY MIAMI · ONE WORLD. ONE GAME.</title>
<style>
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;margin:0;padding:0}
  html,body{height:100%;background:#0a0a12;color:#f4f4f8;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
  header{padding:20px 24px;text-align:center;border-bottom:1px solid #ffffff14}
  header .b{font-weight:800;font-size:24px;letter-spacing:.5px}
  header .s{color:#9aa0b5;font-size:12px;letter-spacing:2px;margin-top:4px}
  #grid{padding:18px;display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px}
  .card{background:#14141f;border:1px solid #ffffff14;border-radius:18px;overflow:hidden;cursor:pointer;transition:transform .12s}
  .card:active{transform:scale(.97)}
  .card .ph{height:230px;background:#1d1d2b;display:flex;align-items:center;justify-content:center;font-size:50px}
  .card img{display:block;width:100%;height:230px;object-fit:cover;background:#1d1d2b}
  .card .m{padding:12px 14px}
  .card h3{font-size:16px;line-height:1.2}
  .card .p{margin-top:6px;color:#ffcf4d;font-weight:700}
  .empty{padding:50px;text-align:center;color:#9aa0b5;font-size:16px;line-height:1.6}
  #ov{position:fixed;inset:0;background:rgba(0,0,0,.88);display:none;align-items:center;justify-content:center;padding:20px;z-index:99}
  #ov.on{display:flex}
  .box{background:#14141f;border-radius:20px;max-width:560px;width:100%;max-height:92vh;overflow:auto}
  .box img{width:100%;max-height:56vh;object-fit:contain;background:#0d0d18;display:block}
  .box .c{padding:18px 20px}
  .box h2{font-size:22px;margin-bottom:6px}
  .box .p{color:#ffcf4d;font-weight:700;font-size:18px;margin-bottom:10px}
  .box .d{color:#d7d9e6;font-size:15px;line-height:1.55}
  .x{position:fixed;top:14px;right:18px;font-size:36px;color:#fff;cursor:pointer;z-index:100;line-height:1}
</style>
</head>
<body>
<header>
  <div class="b">ONE WORLD. ONE GAME.</div>
  <div class="s">FACUNDO YEBNE · FLY · KIMPTON EPIC</div>
</header>
<div id="grid"></div>
<div id="ov"><span class="x" id="x">&times;</span><div class="box"><img id="ovimg" alt="" /><div class="c"><h2 id="ovt"></h2><div class="p" id="ovp"></div><div class="d" id="ovd"></div></div></div></div>

<script>
window.ART = [
  {% for product in collections['kiosk'].products %}{
    t: {{ product.title | json }},
    p: {{ product.price | money_without_trailing_zeros | json }},
    img: {% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | json }}{% else %}""{% endif %},
    d: {{ product.description | strip_html | strip_newlines | json }}
  }{% unless forloop.last %},{% endunless %}{% endfor %}
];
</script>
<script>
(function(){
  var g = document.getElementById("grid"), ov = document.getElementById("ov");
  function esc(s){ return (s||"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }
  function escA(s){ return esc(s).replace(/"/g,"&quot;"); }
  if(!ART.length){ g.outerHTML = '<div class="empty">No pieces yet. In Shopify, add products to the <b>Kiosk</b> collection and they show up here.</div>'; return; }
  ART.forEach(function(a){
    var c = document.createElement("div"); c.className = "card";
    var vis = a.img ? '<img src="'+a.img+'" loading="lazy" decoding="async" alt="'+escA(a.t)+'">' : '<div class="ph">🦆</div>';
    c.innerHTML = vis + '<div class="m"><h3>'+esc(a.t)+'</h3><div class="p">'+esc(a.p)+'</div></div>';
    c.onclick = function(){
      document.getElementById("ovimg").src = a.img || "";
      document.getElementById("ovt").textContent = a.t;
      document.getElementById("ovp").textContent = a.p;
      document.getElementById("ovd").textContent = a.d || "One of a kind original by Facundo Yebne.";
      ov.classList.add("on");
    };
    g.appendChild(c);
  });
  function close(){ ov.classList.remove("on"); }
  document.getElementById("x").onclick = close;
  ov.onclick = function(e){ if(e.target === ov) close(); };
})();
</script>
</body>
</html>
