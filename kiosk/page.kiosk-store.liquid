{% layout none %}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
<title>FLY MIAMI · Kiosk</title>
<style>
  :root{--bg:#0a0a12;--panel:#14141f;--ink:#f4f4f8;--muted:#9aa0b5;--accent:#ff3da6;--accent2:#36c5ff;--gold:#ffcf4d}
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{margin:0;height:100%;background:var(--bg);color:var(--ink);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;overflow:hidden}
  #app{display:flex;flex-direction:column;height:100vh}
  header{padding:22px 28px 14px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ffffff14}
  .brand{font-weight:800;letter-spacing:.5px;font-size:26px}
  .brand small{display:block;font-weight:500;color:var(--muted);font-size:13px;letter-spacing:2px;margin-top:2px}
  .live{font-size:12px;color:var(--muted)}
  #about{padding:14px 28px;border-bottom:1px solid #ffffff14;background:#0d0d18;max-height:24vh;overflow-y:auto}
  #about h2{margin:0 0 6px;font-size:15px;letter-spacing:.5px;color:var(--accent)}
  #about p{margin:0;font-size:13.5px;line-height:1.5;color:#d7d9e6;max-width:1100px}
  main{flex:1;display:flex;min-height:0}
  #gallery{flex:1.4;overflow-y:auto;padding:20px;display:grid;
    grid-template-columns:repeat(auto-fill,minmax(220px,1fr));grid-auto-rows:max-content;gap:16px;align-content:start}
  .card{background:var(--panel);border:1px solid #ffffff14;border-radius:18px;overflow:hidden;
    cursor:pointer;transition:transform .12s ease,border-color .12s ease;display:flex;flex-direction:column}
  .card:active{transform:scale(.97)}
  .card.sel{border-color:var(--accent)}
  .thumb{min-height:200px;flex:0 0 auto;overflow:hidden;background:#1d1d2b;display:flex;align-items:center;justify-content:center;font-size:46px;position:relative}
  .thumb img{display:block;width:100%;height:200px;object-fit:cover}
  .meta{padding:12px 14px}
  .meta h3{margin:0 0 4px;font-size:15px;line-height:1.2}
  .meta .price{margin-top:6px;font-weight:700;color:var(--gold);font-size:14px}
  #guide{flex:1;min-width:340px;max-width:460px;border-left:1px solid #ffffff14;display:flex;flex-direction:column;background:#0d0d18}
  #chat{flex:1;overflow-y:auto;padding:18px;display:flex;flex-direction:column;gap:12px}
  .bubble{max-width:90%;padding:12px 15px;border-radius:16px;font-size:15px;line-height:1.4}
  .me{align-self:flex-end;background:var(--accent2);color:#012;border-bottom-right-radius:4px}
  .fy{align-self:flex-start;background:#1c1c2b;border-bottom-left-radius:4px}
  .fy b{color:var(--accent)}
  .inrow{display:flex;gap:8px;padding:12px 14px;border-top:1px solid #ffffff14}
  #q{flex:1;background:#1c1c2b;border:1px solid #ffffff1a;border-radius:14px;color:var(--ink);padding:12px 14px;font-size:15px;outline:none}
  .btn{background:var(--accent);color:#012;border:none;border-radius:14px;padding:0 16px;font-weight:700;font-size:15px;cursor:pointer}
  .btn.alt{background:#1c1c2b;color:var(--ink);border:1px solid #ffffff1a}
  .speakhint{font-size:11px;color:var(--muted);text-align:center;padding:4px 0 10px}
  .empty{padding:40px 28px;color:var(--muted);font-size:15px;line-height:1.6}
  @media(max-width:820px){
    main{flex-direction:column} #guide{max-width:none;border-left:none;border-top:1px solid #ffffff14}
    #gallery{display:block;flex:none;max-height:46vh}
    #gallery .card{margin-bottom:16px}
    .thumb{min-height:230px} .thumb img{height:230px}
  }
</style>
</head>
<body>
<div id="app">
  <header>
    <div class="brand">FLY MIAMI <small>FACUNDO YEBNE · KIMPTON EPIC · 2026</small></div>
    <div class="live">Tap an artwork &nbsp;·&nbsp; or ask me anything</div>
  </header>
  <section id="about">
    <h2>About the show &amp; the artist</h2>
    <p id="aboutText"></p>
  </section>
  <main>
    <section id="gallery"></section>
    <aside id="guide">
      <div id="chat"></div>
      <div class="inrow">
        <input id="q" placeholder="Ask about the show…" autocomplete="off" />
        <button class="btn" id="ask">Ask</button>
        <button class="btn alt" id="mic" title="Speak">🎤</button>
      </div>
      <div class="speakhint" id="ttsToggle">🔇 Voice OFF · tap to unmute</div>
    </aside>
  </main>
</div>

<script>
/* Data comes from the "Kiosk" Shopify collection — manage products there to control this page. */
window.KIOSK = {
  about: {{ collections['kiosk'].description | default: 'Tap any piece to hear its story, or ask me anything.' | json }},
  art: [
    {% for product in collections['kiosk'].products %}{
      title: {{ product.title | json }},
      price: {{ product.price | money_without_trailing_zeros | json }},
      img: {% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | json }}{% else %}""{% endif %},
      desc: {{ product.description | strip_html | strip_newlines | json }},
      url: {{ product.url | json }},
      handle: {{ product.handle | json }}
    }{% unless forloop.last %},{% endunless %}{% endfor %}
  ]
};
</script>
<script>
(function(){
  var ARTIST_HANDLE = "@flymiami.art";
  var ART = (window.KIOSK && window.KIOSK.art) || [];
  var ttsOn = false, selected = null;

  document.getElementById("aboutText").innerHTML =
    (window.KIOSK.about || "") + ' <b>' + ART.length + ' works</b> on view. Tap any piece for its story, or ask me anything. Find me at <b>' + ARTIST_HANDLE + '</b>.';

  var gallery = document.getElementById("gallery");
  if(!ART.length){
    gallery.className = ""; gallery.innerHTML = '<div class="empty">No pieces selected yet. In Shopify admin, open <b>Products → Collections → Kiosk</b> and add the artworks you want shown here. They appear automatically.</div>';
  }
  ART.forEach(function(a, i){
    var c = document.createElement("div");
    c.className = "card"; c.dataset.i = i;
    var visual = a.img ? '<img src="'+a.img+'" alt="'+escapeAttr(a.title)+'" onerror="this.style.display=\'none\';this.parentNode.insertAdjacentText(\'beforeend\',\'🦆\')">' : "🦆";
    c.innerHTML = '<div class="thumb">'+visual+'</div><div class="meta"><h3>'+(i+1)+'. '+escapeHtml(a.title)+'</h3><div class="price">'+escapeHtml(a.price)+'</div></div>';
    c.onclick = function(){ selectArt(i); };
    gallery.appendChild(c);
  });

  var chat = document.getElementById("chat");
  function say(text, who){
    who = who || "fy";
    var b = document.createElement("div");
    b.className = "bubble " + who; b.innerHTML = text;
    chat.appendChild(b); chat.scrollTop = chat.scrollHeight;
  }
  function selectArt(i){
    selected = ART[i];
    var cards = document.querySelectorAll(".card");
    for(var k=0;k<cards.length;k++) cards[k].classList.toggle("sel", cards[k].dataset.i == i);
    say("<b>"+escapeHtml(selected.title)+"</b> — "+escapeHtml(selected.price)+"<br><br>"+escapeHtml(selected.desc || "One-of-a-kind original by Facundo Yebne."));
    playClip(selected.handle);
  }
  function answer(qRaw){
    var q = qRaw.toLowerCase();
    var hit = ART.filter(function(a){ return a.title && q.indexOf(a.title.toLowerCase().split(" ")[0]) >= 0; })[0];
    if(/who|your name|about you|artist|facundo|\bfly\b/.test(q)) return "<b>"+escapeHtml(window.KIOSK.about||"I'm Facundo Yebne, FLY — I build art from thousands of rubber and resin ducks.")+"</b>";
    if(/how many|number|total/.test(q)) return "There are <b>"+ART.length+" works</b> on view. Tap any one for its story.";
    if(/price|cost|how much|buy|purchase/.test(q)){ if(hit) return "<b>"+escapeHtml(hit.title)+"</b> is <b>"+escapeHtml(hit.price)+"</b>."; return "Tap any artwork to see its price and story."; }
    if(hit) return "<b>"+escapeHtml(hit.title)+"</b> — "+escapeHtml(hit.desc||"");
    return "Tap any artwork to hear its story, or ask me about a specific piece by name.";
  }
  function handleAsk(t){ if(!t.trim()) return; say(escapeHtml(t),"me"); setTimeout(function(){ say(answer(t)); }, 200); }

  var q = document.getElementById("q");
  document.getElementById("ask").onclick = function(){ handleAsk(q.value); q.value=""; };
  q.addEventListener("keydown", function(e){ if(e.key==="Enter"){ handleAsk(q.value); q.value=""; } });

  /* FLY's own recordings: drop MP3s named by product handle at the URL below (audio/<handle>.mp3, plus audio/welcome.mp3). No clip means silence, never a robot voice. */
  var AUDIO_BASE = "https://flymiami.github.io/May26/audio/";
  var currentAudio = null;
  function stopClip(){ if(currentAudio){ try{ currentAudio.pause(); }catch(e){} currentAudio=null; } }
  function playClip(slug){ if(!ttsOn || !slug) return; stopClip(); var a = new Audio(AUDIO_BASE + slug + ".mp3"); currentAudio = a; a.play().catch(function(){}); }
  document.getElementById("ttsToggle").onclick = function(){ ttsOn = !ttsOn; this.textContent = ttsOn ? "🔊 Voice ON · tap to mute" : "🔇 Voice OFF · tap to unmute"; if(!ttsOn) stopClip(); };

  var mic = document.getElementById("mic");
  var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if(SR){ var rec = new SR(); rec.lang="en-US"; rec.interimResults=false; mic.onclick=function(){ try{ rec.start(); mic.textContent="…"; }catch(e){} }; rec.onresult=function(e){ mic.textContent="🎤"; handleAsk(e.results[0][0].transcript); }; rec.onerror=function(){ mic.textContent="🎤"; }; rec.onend=function(){ mic.textContent="🎤"; }; } else { mic.style.display="none"; }

  function escapeHtml(s){ return (s||"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }
  function escapeAttr(s){ return escapeHtml(s).replace(/"/g,"&quot;"); }

  say("👋 Hi, I'm <b>Facundo</b>. Welcome to my show — thousands of rubber ducks for peace, love and joy. Tap any piece to hear its story, or ask me anything.");
  document.addEventListener("click", function(){ playClip("welcome"); }, {once:true});
})();
</script>
</body>
</html>
