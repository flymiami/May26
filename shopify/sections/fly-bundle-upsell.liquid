{{ 'fly-bundle-upsell.css' | asset_url | stylesheet_tag }}

{%- assign bundle_total = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.settings.product != blank -%}
    {%- assign bundle_total = bundle_total | plus: block.settings.product.price -%}
  {%- endif -%}
{%- endfor -%}

<section class="fly-bundle" aria-label="{{ section.settings.heading | escape }}">
  <div class="fly-bundle__inner">
    <p class="fly-bundle__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="fly-bundle__heading">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.subhead != blank -%}
      <p class="fly-bundle__subhead">{{ section.settings.subhead | escape }}</p>
    {%- endif -%}

    <div class="fly-bundle__items">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        {%- if product != blank -%}
          <div class="fly-bundle__item" {{ block.shopify_attributes }}>
            <a href="{{ product.url }}" class="fly-bundle__item-media">
              {{ product.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: product.title }}
            </a>
            <p class="fly-bundle__item-title">{{ product.title }}</p>
            <p class="fly-bundle__item-price">{{ product.price | money }}</p>
          </div>
          {%- unless forloop.last -%}
            <div class="fly-bundle__plus" aria-hidden="true">+</div>
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="fly-bundle__summary">
      <div class="fly-bundle__price-row">
        <span>Bundle price</span>
        <strong>{{ bundle_total | money }}</strong>
      </div>
      {%- if section.settings.discount_note != blank -%}
        <p class="fly-bundle__discount-note">{{ section.settings.discount_note | escape }}</p>
      {%- endif -%}
      {%- if section.settings.code != blank -%}
        <p class="fly-bundle__code">Use code <strong>{{ section.settings.code | escape }}</strong> at checkout</p>
      {%- endif -%}
      {%- if section.settings.cta_url != blank -%}
        <a href="{{ section.settings.cta_url }}" class="fly-bundle__cta">{{ section.settings.cta_text | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FLY Bundle Upsell",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Complete the collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bundle & save" },
    { "type": "textarea", "id": "subhead", "label": "Subhead", "default": "Pair a signed print with the tee and get both for less than a single original." },
    { "type": "text", "id": "discount_note", "label": "Discount note", "default": "Save 15% when you add both to your cart" },
    { "type": "text", "id": "code", "label": "Discount code to display (create the matching code in Shopify Discounts)", "default": "BUNDLE15" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Shop the bundle" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "bundle_item",
      "name": "Bundle item",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FLY Bundle Upsell",
      "blocks": [
        { "type": "bundle_item" },
        { "type": "bundle_item" }
      ]
    }
  ]
}
{% endschema %}
