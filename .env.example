# Supabase — get these from supabase.com → project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth — only the owner email(s) below can sign in until invites are wired
ALLOWED_EMAILS=fy@designsuitesmiami.com

# Ads integrations (Phase 2) — leave blank until ready
GOOGLE_ADS_DEVELOPER_TOKEN=
META_ADS_ACCESS_TOKEN=

# Accounting integrations (Phase 2)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
