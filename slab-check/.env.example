# --- required ---------------------------------------------------------
# Anthropic key used by /api/identify. Server side only; never exposed to
# the browser. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- optional ---------------------------------------------------------
# Vision model. Defaults to claude-sonnet-4-6.
# CLAUDE_MODEL=claude-sonnet-4-6

# Cloud mirror of the collection. Leave both unset to stay local-only
# (IndexedDB on the phone). Use the SERVICE ROLE key, not the anon key:
# it is read server side only.
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# SUPABASE_TABLE=slab_check_collection
